# Normal running: HTTP only serves the certificate check and redirects.
# ${DOMAIN} is filled in from the container environment.

# Reads are generous (a whole venue can share one Wi-Fi address); posts are tight.
# An empty key is not counted, so each zone only sees its own method.
map $request_method $gb_get_key  { GET $binary_remote_addr; HEAD $binary_remote_addr; default ""; }
map $request_method $gb_post_key { POST $binary_remote_addr; default ""; }
limit_req_zone $gb_get_key  zone=gb_get:10m  rate=300r/m;
limit_req_zone $gb_post_key zone=gb_post:10m rate=10r/m;

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# www goes to the bare domain
server {
    listen 443 ssl;
    http2 on;
    server_name www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    return 301 https://${DOMAIN}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json text/plain;
    gzip_min_length 512;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # dev-only style guide is never served
    location = /preview.html    { return 404; }
    location = /css/preview.css { return 404; }

    # no fingerprinted filenames yet, so keep code caches short
    location ~* \.(?:css|js)$ {
        add_header Cache-Control "public, max-age=3600";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location ~* \.(?:png|jpe?g|webp|svg|ico|mp3|woff2?)$ {
        add_header Cache-Control "public, max-age=2592000";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }


    # guestbook service (internal only); resolved at request time so nginx
    # still starts if the service is briefly down
    location /api/ {
        resolver 127.0.0.11 valid=10s;
        set $api http://api:3000;
        client_max_body_size 8k;
        limit_req zone=gb_get  burst=60 nodelay;
        limit_req zone=gb_post burst=5  nodelay;
        limit_req_status 429;
        error_page 429 = @rate_limited;
        proxy_pass $api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 15s;
    }

    # the page's script expects JSON, so answer the limit in JSON
    location @rate_limited {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 429 '{"error":"rate_limited"}';
    }

    location / {
        # /guest-slug/ becomes /guest-slug, then falls back to index.html
        rewrite ^/(.+)/$ /$1 permanent;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
}
