# First boot: plain HTTP, so certbot can prove the domain. Also serves the
# site, so you can check it before the certificate exists.

# Reads are generous (a whole venue can share one Wi-Fi address); posts are tight.
# An empty key is not counted, so each zone only sees its own method.
map $request_method $gb_get_key  { GET $binary_remote_addr; HEAD $binary_remote_addr; default ""; }
map $request_method $gb_post_key { POST $binary_remote_addr; default ""; }
limit_req_zone $gb_get_key  zone=gb_get:10m  rate=300r/m;
limit_req_zone $gb_post_key zone=gb_post:10m rate=10r/m;

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    root /usr/share/nginx/html;
    index index.html;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location = /preview.html   { return 404; }
    location = /css/preview.css { return 404; }


    # guestbook service (internal only); resolved at request time so nginx
    # still starts if the service is briefly down
    location /api/ {
        resolver 127.0.0.11 valid=10s;
        set $api http://api:3000;
        client_max_body_size 8k;
        limit_req zone=gb_get  burst=60 nodelay;
        limit_req zone=gb_post burst=5  nodelay;
        limit_req_status 429;
        error_page 429 = @rate_limited;
        proxy_pass $api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 15s;
    }

    location @rate_limited {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 429 '{"error":"rate_limited"}';
    }

    location / {
        # strip a trailing slash so relative asset paths never break
        rewrite ^/(.+)/$ /$1 permanent;
        try_files $uri $uri/ /index.html;
    }
}
