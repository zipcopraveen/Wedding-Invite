# First boot: plain HTTP, so certbot can prove the domain. Also serves the
# site, so you can check it before the certificate exists.

limit_req_zone $binary_remote_addr zone=guestbook:10m rate=30r/m;

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    root /usr/share/nginx/html;
    index index.html;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location = /preview.html   { return 404; }
    location = /css/preview.css { return 404; }


    # guestbook service (internal only); resolved at request time so nginx
    # still starts if the service is briefly down
    location /api/ {
        resolver 127.0.0.11 valid=10s;
        set $api http://api:3000;
        client_max_body_size 8k;
        limit_req zone=guestbook burst=20 nodelay;
        proxy_pass $api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 15s;
    }

    location / {
        # strip a trailing slash so relative asset paths never break
        rewrite ^/(.+)/$ /$1 permanent;
        try_files $uri $uri/ /index.html;
    }
}
